@*
  【文件】_SidebarCollapseToggle.cshtml — Partial：侧栏折叠按钮
  【交互】点击后由 wwwroot/js/site.js 切换 data-workbench-root 样式
*@
<button type="button"
        class="sidebar-collapse-toggle"
        data-sidebar-toggle
        aria-expanded="true"
        title="收起侧栏">
    <svg class="sidebar-toggle-svg sidebar-toggle-svg--to-collapse" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="4.25" y="5" width="15.5" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.65" />
        <line x1="9.65" y1="5" x2="9.65" y2="19" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" />
    </svg>
    <svg class="sidebar-toggle-svg sidebar-toggle-svg--to-expand" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="4.25" y="5" width="15.5" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.65" />
        <line x1="14.35" y1="5" x2="14.35" y2="19" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" />
    </svg>
</button>
