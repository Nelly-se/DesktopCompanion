@page
@model SpiritDesk.Web.Pages.ChatModel
@inject SpiritDesk.Web.Services.SpiritPersonaService PersonaService
@{
    ViewData["Title"] = "精灵聊天";
    var profile = Model.ChatHistory.Profile;
    var spirit = Model.ChatHistory.CurrentSpirit;
    var spirits = Model.ChatHistory.Spirits;
    var messages = Model.ChatHistory.Messages;
    var liveMessages = Model.ChatHistory.CurrentConversationMessages;

    string ResolveThreadSpiritId(SpiritDesk.Core.Entities.ChatMessage message)
    {
        if (!string.IsNullOrWhiteSpace(message.SpiritId))
        {
            return message.SpiritId;
        }

        return spirit.Id;
    }

    string ResolveSpeakerName(SpiritDesk.Core.Entities.ChatMessage message)
    {
        if (message.Sender == "user")
        {
            return string.IsNullOrWhiteSpace(profile.Nickname) ? "你" : profile.Nickname;
        }

        if (!string.IsNullOrWhiteSpace(message.SpiritId))
        {
            var matchedSpirit = spirits.FirstOrDefault(x => x.Id == message.SpiritId);
            if (matchedSpirit is not null)
            {
                return matchedSpirit.Name;
            }
        }

        return "精灵";
    }
}

<div class="workbench-app" data-workbench-root style="--spirit-accent:@spirit.AccentColor">
    <aside class="sidebar">
        <partial name="Shared/_SidebarCollapseToggle" />
        <div class="sidebar-body">
            <div class="sidebar-brand-row brand-compact">
                <div class="brand-avatar">灵</div>
                <div class="brand-text">
                    <h2>光合桌面</h2>
                    <p>SpiritDesk</p>
                </div>
            </div>
            <nav class="nav-menu">
                <a class="nav-item" asp-page="/Index"><span class="nav-label">首页 / 精灵主页</span></a>
                <a class="nav-item active" asp-page="/Chat"><span class="nav-label">精灵聊天</span></a>
                <a class="nav-item" asp-page="/Assistant"><span class="nav-label">任务助手</span></a>
                <a class="nav-item" asp-page="/Settings"><span class="nav-label">精灵设置</span></a>
            </nav>

            <section class="sidebar-section spirit-pool">
                <div class="sidebar-title-row">
                    <span>当前精灵池</span>
                    <span class="tiny-badge">@spirits.Count</span>
                </div>
                <div class="mini-dock-wrap">
                    <div class="mini-dock mini-dock-switchable">
                        @foreach (var item in spirits)
                        {
                            var isCurrent = item.Id == spirit.Id;
                            if (isCurrent)
                            {
                                <div class="mini-ball active" style="--ball-accent:@item.AccentColor" title="@item.Name">
                                    <img src="@item.ImagePath" alt="@item.Name" />
                                </div>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="SwitchSpirit" class="mini-dock-form">
                                    <input type="hidden" asp-for="SpiritId" value="@item.Id" />
                                    <button type="submit" class="mini-ball mini-ball-button" style="--ball-accent:@item.AccentColor" title="切换到 @item.Name">
                                        <img src="@item.ImagePath" alt="@item.Name" />
                                    </button>
                                </form>
                            }
                        }
                    </div>
                </div>
            </section>
        </div>
    </aside>

    <main class="main-workbench">
        <section class="hero-head">
            <div>
                <h1>精灵聊天</h1>
                <p>左侧与 <strong>@spirit.Name</strong> 持续对话，右侧查看全部历史。</p>
            </div>
            <div class="hero-toolbar">
                <a class="toolbar-pill active" asp-page="/Chat">全部记录</a>
                <a class="toolbar-pill" asp-page="/Index">返回精灵主页</a>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.NoticeMessage))
        {
            <div class="notice-banner">@Model.NoticeMessage</div>
        }

        <section class="chat-history-grid">
            <section class="chat-live-column">
                <section class="content-card chat-summary-card chat-live-card">
                    <div class="chat-sidebar-card">
                    <div class="chat-sidebar-head">
                        <div>
                            <span class="card-kicker">Live</span>
                            <h3>@spirit.Name · @spirit.Title</h3>
                            <p>@spirit.Personality</p>
                        </div>
                        <span class="tiny-badge">@spirit.Mbti</span>
                    </div>

                    <div class="chat-sidebar-summary">
                        <div class="task-overview-grid chat-overview-grid">
                            <div class="task-overview-pill">
                                <strong>@Model.ChatHistory.TotalMessageCount</strong>
                                <span>总消息数</span>
                            </div>
                            <div class="task-overview-pill">
                                <strong>@Model.ChatHistory.UserMessageCount</strong>
                                <span>@(string.IsNullOrWhiteSpace(profile.Nickname) ? "你" : profile.Nickname)</span>
                            </div>
                            <div class="task-overview-pill">
                                <strong>@Model.ChatHistory.SpiritMessageCount</strong>
                                <span>@spirit.Name</span>
                            </div>
                            <div class="task-overview-pill">
                                <strong>@Model.ChatHistory.ActiveThreadCount</strong>
                                <span>已聊天精灵</span>
                            </div>
                        </div>

                        <div class="chat-persona-note">
                            <strong>@spirit.Name 的聊天风格</strong>
                            <p>@spirit.Description</p>
                            <span>@spirit.SpecialMechanism</span>
                        </div>
                    </div>

                    <div class="chat-sidebar-body chat-live-stream" id="chatLiveStream">
                        @if (liveMessages.Count == 0)
                        {
                            <div class="chat-empty-state">
                                <strong>还没有和 @spirit.Name 的独立对话</strong>
                                <p>发出第一条消息吧，这位精灵会按自己的性格和你互动。</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var message in liveMessages)
                            {
                                var isUser = message.Sender == "user";
                                <article id="chat-message-@message.Id" class="chat-live-message @(isUser ? "user" : "spirit") @(Model.FocusMessageId == message.Id ? "is-focused" : string.Empty)">
                                    <div class="chat-live-meta">
                                        <strong>@ResolveSpeakerName(message)</strong>
                                        <span>@message.CreatedAt.ToString("MM-dd HH:mm")</span>
                                    </div>
                                    <div class="chat-live-bubble">
                                        @message.Content
                                    </div>
                                </article>
                            }
                        }
                    </div>
                    </div>
                </section>

                <form method="post" asp-page-handler="SendMessage" class="content-card chat-composer-card">
                    <input type="hidden" asp-for="SpiritId" value="@spirit.Id" />
                    <textarea asp-for="MessageText" class="soft-input chat-composer-input" rows="2" placeholder="继续向 @spirit.Name 发送消息，@PersonaService.BuildChatPromptSuggestion(spirit)"></textarea>
                    <button type="submit" class="action-button mint">发送消息</button>
                </form>
            </section>

            <section class="content-card chat-history-card">
                <div class="card-head">
                    <div>
                        <span class="card-kicker">History</span>
                        <h3>完整聊天记录</h3>
                    </div>
                    <span class="tiny-badge">按时间顺序</span>
                </div>

                <div class="chat-timeline">
                    @if (messages.Count == 0)
                    {
                        <div class="stack-item">
                            <p>还没有聊天记录，先发送第一条消息吧。</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var message in messages)
                        {
                            var isUser = message.Sender == "user";
                            <a class="history-message-link" asp-page="/Chat" asp-route-spiritId="@ResolveThreadSpiritId(message)" asp-route-focusMessageId="@message.Id">
                                <article class="history-message-row history-message-jump @(isUser ? "user" : "spirit")">
                                    <div class="history-message-meta">
                                        <strong>@ResolveSpeakerName(message)</strong>
                                        <span>@message.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                    </div>
                                    <p>@message.Content</p>
                                </article>
                            </a>
                        }
                    }
                </div>
            </section>
        </section>
    </main>
</div>

@section Scripts {
    <script>
        window.addEventListener("load", function () {
            const stream = document.getElementById("chatLiveStream");
            if (stream) {
                const focusedMessage = document.querySelector(".chat-live-message.is-focused");
                if (focusedMessage) {
                    focusedMessage.scrollIntoView({ block: "center", behavior: "smooth" });
                } else {
                    stream.scrollTop = stream.scrollHeight;
                }
            }
        });
    </script>
}
