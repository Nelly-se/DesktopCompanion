@*
  【文件】Assistant.cshtml — SSR 页面（内容较少，主要是互动按钮区）
  【URL】GET /Assistant
  【后端】Assistant.cshtml.cs → OnPostInteract / OnPostSelectSpirit
  【界面】任务助手：签到、投喂等，展示当前精灵摘要
*@
@page
@model AssistantModel
@{
    ViewData["Title"] = "任务助手";
    var profile = Model.Desk.Profile;
    var spirit = Model.Desk.CurrentSpirit;
    var counts = Model.Desk.DailyCounts;
}
<div class="workbench-app" data-workbench-root style="--spirit-accent:@spirit.AccentColor">
<aside class="sidebar"><partial name="Shared/_SidebarCollapseToggle" /><div class="sidebar-body"><div class="sidebar-brand-row brand-compact"><div class="brand-avatar">灵</div><div class="brand-text"><h2>光合桌面</h2><p>SpiritDesk</p></div></div><nav class="nav-menu"><a class="nav-item" asp-page="/Index"><span class="nav-label">首页 / 精灵主页</span></a><a class="nav-item" asp-page="/Chat"><span class="nav-label">精灵聊天</span></a><a class="nav-item active" asp-page="/Assistant"><span class="nav-label">任务助手</span></a><a class="nav-item" asp-page="/Settings"><span class="nav-label">精灵设置</span></a></nav></div></aside>
<main class="main-workbench"><section class="hero-head"><div><h1>任务助手</h1><p>集中处理每日签到、投喂、互动等动作，并查看当前精灵状态。</p></div><div class="hero-toolbar"><a class="toolbar-pill" asp-page="/Index">返回精灵主页</a></div></section>
@if (!string.IsNullOrWhiteSpace(Model.NoticeMessage)){<div class="notice-banner">@Model.NoticeMessage</div>}
<section class="assistant-page-grid"><section class="assistant-card assistant-page-stage"><div class="assistant-top"><div><h3>@spirit.Name</h3><p>@spirit.Title</p></div></div><div class="spirit-stage-compact"><div class="compact-orb"><img src="@spirit.ImagePath" alt="@spirit.Name" /></div></div><div class="assistant-stats"><div><strong>今日 @(counts.TryGetValue("checkin", out var c) ? c : 0)</strong><span>每日签到</span></div><div><strong>@profile.Affinity</strong><span>亲密度</span></div><div><strong>@profile.Coins</strong><span>金币</span></div></div><button class="wide-ghost">@spirit.Mbti · @spirit.CoreRole</button><p class="assistant-foot">@spirit.SpecialMechanism</p><p class="assistant-foot">@spirit.Description</p></section>
<section class="helper-card"><div class="card-head"><h3>快捷互动</h3></div><div class="action-group"><form method="post" asp-page-handler="Interact"><input type="hidden" asp-for="ActionType" value="checkin" /><button type="submit" class="action-button white">每日签到</button></form><form method="post" asp-page-handler="Interact"><input type="hidden" asp-for="ActionType" value="feed" /><button type="submit" class="action-button white">投喂</button></form><form method="post" asp-page-handler="Interact"><input type="hidden" asp-for="ActionType" value="study" /><button type="submit" class="action-button white">互动：陪我学习</button></form><form method="post" asp-page-handler="Interact"><input type="hidden" asp-for="ActionType" value="rest" /><button type="submit" class="action-button white">互动：提醒休息</button></form><form method="post" asp-page-handler="Interact"><input type="hidden" asp-for="ActionType" value="encourage" /><button type="submit" class="action-button white">互动：鼓励一下</button></form></div><p class="game-card-hint">猜拳小游戏在首页顶部打开，适合作为“主页工作台 + 小游戏弹层”答辩演示环节。</p><a class="action-button purple" asp-page="/Index" style="width:100%;display:flex;justify-content:center;align-items:center;box-sizing:border-box;">去首页打开猜拳小游戏</a></section></section></main></div>
