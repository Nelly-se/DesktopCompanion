@page

@model SpiritDesk.Web.Pages.RegisterModel



<div class="login-shell">

    <div class="login-card content-card">

        <div class="login-brand">

            <div class="brand-avatar">灵</div>

            <div>

                <p class="login-kicker">光合桌面</p>

                <h1 class="login-title">注册账号</h1>

                <p class="login-lead">创建 SpiritDesk 登录账号后继续</p>

            </div>

        </div>



        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))

        {

            <div class="notice-banner login-error">@Model.ErrorMessage</div>

        }



        <form method="post" class="login-form">

            <label asp-for="Username" class="balance-label">用户名</label>

            <input asp-for="Username" class="soft-input" autocomplete="username" required maxlength="32"

                   placeholder="3～32 位，字母数字或下划线等" />



            <label asp-for="Password" class="balance-label login-gap">密码</label>

            <input asp-for="Password" type="password" class="soft-input" autocomplete="new-password" required minlength="6"

                   maxlength="128" placeholder="至少 6 位" />



            <label asp-for="ConfirmPassword" class="balance-label login-gap">确认密码</label>

            <input asp-for="ConfirmPassword" type="password" class="soft-input" autocomplete="new-password" required />



            <button type="submit" class="action-button mint login-submit">注册</button>

        </form>



        <p class="login-register-hint text-center mt-3 mb-0">

            <a asp-page="/Login">已有账号？去登录</a>

        </p>

    </div>

</div>

