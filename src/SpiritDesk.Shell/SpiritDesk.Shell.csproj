<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SpiritDesk.Core\SpiritDesk.Core.csproj" />
    <!-- 保证 dotnet run Shell 时总会重新编译 Web；否则会长期用到旧的 SpiritDesk.Web.dll（页面仍是旧版） -->
    <ProjectReference Include="..\SpiritDesk.Web\SpiritDesk.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
