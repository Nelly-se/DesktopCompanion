<!-- CompanionBubbleWindow.xaml — 桌面浮球 UI（透明置顶、展开面板）；逻辑在 .xaml.cs -->
<Window x:Class="SpiritDesk.Shell.CompanionBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpiritDeskBubble"
        Width="88"
        Height="88"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        MouseDoubleClick="Bubble_MouseDoubleClick"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelTextPrimaryBrush" Color="#173229" />
        <SolidColorBrush x:Key="PanelTextSoftBrush" Color="#5E766E" />
        <SolidColorBrush x:Key="PanelLineBrush" Color="#D5E7DE" />
        <SolidColorBrush x:Key="PanelButtonFillBrush" Color="#F7FBF8" />
        <SolidColorBrush x:Key="PanelButtonBorderBrush" Color="#CEE3D8" />
        <SolidColorBrush x:Key="PanelButtonHoverBrush" Color="#ECF6F0" />
        <SolidColorBrush x:Key="PanelButtonTextBrush" Color="#19342A" />
        <SolidColorBrush x:Key="PanelPrimaryButtonBrush" Color="#4E9C74" />
        <SolidColorBrush x:Key="PanelPrimaryButtonHoverBrush" Color="#428765" />

        <Style x:Key="CompanionActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PanelButtonTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelButtonFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PanelButtonHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#BFD7CA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompanionPrimaryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CompanionActionButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PanelPrimaryButtonBrush}" />
            <Setter Property="BorderBrush" Value="#3C7A59" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PanelPrimaryButtonHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#356B4F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.93" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompanionStatCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelLineBrush}" />
            <Setter Property="Background" Value="#FBFEFC" />
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#F8FCFA" />
            <Setter Property="BorderBrush" Value="#CBE2D6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24"
                                                  ShadowDepth="4"
                                                  Opacity="0.24"
                                                  Direction="270" />
                            </Border.Effect>
                            <ScrollViewer CanContentScroll="True">
                                <StackPanel IsItemsHost="True" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#183228" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconHost"
                                                  ContentSource="Icon"
                                                  Margin="0,0,10,0"
                                                  VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuChrome" Property="Background" Value="#EEF7F1" />
                                <Setter TargetName="MenuChrome" Property="BorderBrush" Value="#C6DED2" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuChrome" Property="Background" Value="#EEF7F1" />
                                <Setter TargetName="MenuChrome" Property="BorderBrush" Value="#C6DED2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8EA399" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Margin" Value="6,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Background="#D8E8E0"
                                CornerRadius="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="CompanionContextMenu"
                     Opened="CompanionContextMenu_Opened" />
    </Window.ContextMenu>

    <Grid x:Name="RootDragArea"
          Background="Transparent"
          MouseLeftButtonDown="Bubble_MouseLeftButtonDown"
          MouseLeftButtonUp="Bubble_MouseLeftButtonUp"
          MouseMove="Bubble_MouseMove">
        <Grid x:Name="BubbleView" Visibility="Visible">
            <Border x:Name="BubbleBorder"
                    Margin="4"
                    Background="#F6FBF7"
                    BorderBrush="#BFE5CF"
                    BorderThickness="2"
                    CornerRadius="40">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="3"
                                      Opacity="0.28"
                                      Direction="270" />
                </Border.Effect>
                <Grid Margin="8">
                    <Image x:Name="BubbleSpiritImage"
                           Stretch="UniformToFill"
                           Visibility="Collapsed" />
                    <Viewbox x:Name="BubbleFallbackView" Visibility="Visible">
                        <TextBlock x:Name="BubbleFallbackText"
                                   Text="灵"
                                   Foreground="#205C41"
                                   FontWeight="Bold" />
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="PanelView"
                Visibility="Collapsed"
                Margin="4"
                Padding="16"
                Background="#F4FBF7"
                BorderBrush="#BFE5CF"
                BorderThickness="1.5"
                CornerRadius="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  ShadowDepth="4"
                                  Opacity="0.22"
                                  Direction="270" />
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Focusable="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="AvatarBorder"
                                Width="64"
                                Height="64"
                                Margin="0,2,12,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#E6F4EC"
                                BorderBrush="#B8DFC9"
                                BorderThickness="1.5"
                                CornerRadius="32">
                            <Grid Margin="5">
                                <Image x:Name="PanelSpiritImage"
                                       Stretch="UniformToFill"
                                       Visibility="Collapsed" />
                                <Viewbox x:Name="AvatarFallbackView" Visibility="Visible">
                                    <TextBlock x:Name="PanelFallbackText"
                                               Text="灵"
                                               Foreground="#205C41"
                                               FontWeight="Bold" />
                                </Viewbox>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Top">
                            <TextBlock x:Name="NameText"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PanelTextPrimaryBrush}"
                                       Text="卷卷晴" />
                            <TextBlock x:Name="TitleText"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource PanelTextSoftBrush}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Text="工作学习发动机" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                Padding="10,6"
                                Background="#FBFEFC"
                                BorderBrush="{StaticResource PanelLineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                VerticalAlignment="Top">
                            <TextBlock Text="Live"
                                       Foreground="#718A81"
                                       FontSize="11"
                                       FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="14,12"
                            Background="#FBFEFC"
                            BorderBrush="{StaticResource PanelLineBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <TextBlock x:Name="StatusText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource PanelTextSoftBrush}"
                                   FontSize="13.5"
                                   LineHeight="20"
                                   Text="先完成最重要的一件事吧。" />
                    </Border>

                    <Grid Grid.Row="2"
                          Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CompanionStatCardStyle}"
                                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="状态"
                                           Foreground="#7C948B"
                                           FontSize="11"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="MetricsLine1Text"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource PanelTextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="心情 88 · 亲密 120 · Lv.3" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource CompanionStatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="资源"
                                           Foreground="#7C948B"
                                           FontSize="11"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="MetricsLine2Text"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource PanelTextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="金币 20" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3"
                          Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="116" />
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource CompanionPrimaryActionButtonStyle}"
                                Margin="0,0,10,0"
                                Content="打开 SpiritDesk"
                                Click="OpenSpiritDeskButton_Click"
                                PreviewMouseLeftButtonDown="Control_PreviewMouseLeftButtonDown" />

                        <Button Grid.Column="1"
                                Style="{StaticResource CompanionActionButtonStyle}"
                                Content="收起面板"
                                Click="CollapseButton_Click"
                                PreviewMouseLeftButtonDown="Control_PreviewMouseLeftButtonDown" />
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
