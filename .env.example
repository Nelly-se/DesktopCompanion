# SpiritDesk local LLM settings
# Copy this file to ".env" in the repo root or "src/SpiritDesk.Web/.env".
# Keep the real key only in ".env". Do not commit it.

ARK_API_KEY=your-ark-api-key
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260215

# Optional: local demo auth in Development stays enabled by default.
# The built-in demo account is spiritdesk / spiritdesk.
# SpiritDesk__Auth__Enabled=true
