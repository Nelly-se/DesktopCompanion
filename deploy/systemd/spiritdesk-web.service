[Unit]
Description=SpiritDesk Web
After=network.target

[Service]
WorkingDirectory=/opt/spiritdesk/web
ExecStart=/usr/bin/dotnet /opt/spiritdesk/web/SpiritDesk.Web.dll
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=spiritdesk-web
User=www-data
Group=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:8080
Environment=SpiritDesk__DataDirectory=/opt/spiritdesk/data
EnvironmentFile=-/etc/spiritdesk/spiritdesk.env

[Install]
WantedBy=multi-user.target
