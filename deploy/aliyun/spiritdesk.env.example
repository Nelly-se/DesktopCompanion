# Copy to the server:
#   sudo mkdir -p /etc/spiritdesk
#   sudo cp spiritdesk.env.example /etc/spiritdesk/spiritdesk.env
#   sudo chmod 600 /etc/spiritdesk/spiritdesk.env
#
# deploy/systemd/spiritdesk-web.service already loads:
#   EnvironmentFile=-/etc/spiritdesk/spiritdesk.env

SpiritDesk__Auth__Enabled=true
SpiritDesk__Auth__Username=your-demo-username
SpiritDesk__Auth__Password=change-this-password
SpiritDesk__Auth__AllowRegistration=true

# Doubao / Volcengine Ark
ARK_API_KEY=your-ark-api-key
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260215
