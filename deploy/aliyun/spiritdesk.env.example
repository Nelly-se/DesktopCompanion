# 复制到服务器：sudo mkdir -p /etc/spiritdesk && sudo cp spiritdesk.env.example /etc/spiritdesk/spiritdesk.env
# sudo chmod 600 /etc/spiritdesk/spiritdesk.env
# systemd 已配置 EnvironmentFile=-/etc/spiritdesk/spiritdesk.env（见 spiritdesk-web.service）
#
# 下面值为示例，请改成你自己的强密码；不要提交真实密码到 Git。

SpiritDesk__Auth__Enabled=true
SpiritDesk__Auth__Username=你的用户名
SpiritDesk__Auth__Password=请改成强密码
# 设为 false 可关闭自助注册（仅配置账号与已有数据库账号可登录）
SpiritDesk__Auth__AllowRegistration=true
